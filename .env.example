# Chave da conta de serviço (PriceTax → Meus Dados → Integrações). Só no servidor: nunca com prefixo NEXT_PUBLIC_.
PRICETAX_API_KEY=
# Opcional: chaves de outras contas PriceTax, para ver os cálculos de todas no mesmo painel.
PRICETAX_API_KEY_2=
# Opcional: cálculo aberto por padrão (o id aparece na lista do painel).
PRICETAX_CALCULO_ID=
# Opcional: protege o painel com usuário e senha (HTTP Basic). Sem os dois, o painel fica aberto.
PAINEL_USUARIO=
PAINEL_SENHA=
